{
  "uid": "shop",
  "title": "Shop - checkout",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 latency by service and version",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name, service_version) (rate(http_server_request_duration_seconds_bucket{http_route!=\"/health\"}[1m])))",
          "legendFormat": "{{service_name}} {{service_version}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx per second by service and version",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, service_version) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{service_name}} {{service_version}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fraud check p95 by version and outcome",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_version, outcome) (rate(payments_fraud_check_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service_version}} {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Payments errors",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"payments\"} | detected_level=\"error\""
        }
      ]
    }
  ]
}
